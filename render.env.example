# Template only. Type the real values in Render > Environment, never commit them.
# A market shows up on the login screen only when its keys are filled in.
ACCESS_CODE=CHANGE-ME-to-a-long-random-code
BROKER=binance
TIMEZONE=Africa/Nairobi
PYTHON_VERSION=3.12.7

# --- Binance (free testnet): keys from https://testnet.binance.vision
BINANCE_ENV=testnet
# BINANCE_API_KEY=PASTE_KEY
# BINANCE_API_SECRET=PASTE_SECRET

# --- Deriv (free demo): token + app id from https://developers.deriv.com
# DERIV_TOKEN=PASTE_TOKEN
# DERIV_APP_ID=PASTE_APP_ID
# DERIV_ACCOUNT_ID=   (optional, defaults to your first demo account)

# --- MT5 through MetaAPI (paid, hourly)
# METAAPI_TOKEN=PASTE_YOUR_METAAPI_TOKEN
# METAAPI_ACCOUNT_ID=PASTE_YOUR_ACCOUNT_ID
METAAPI_REGION=new-york

# --- Safety limits
ALLOW_LIVE=false
MAX_LOT=0.10
MAX_STAKE=1
MAX_ORDER_USDT=100
MAX_DAILY_LOSS_PCT=3
MAX_POSITIONS=3
DAILY_PROFIT_TARGET=0
DAILY_LOSS_LIMIT=0
TRADE_START_HOUR=0
TRADE_END_HOUR=24
WEEKDAYS_ONLY=true
PRICE_MIN=0
PRICE_MAX=0

# --- Optional AI chat box. Provider: gemini (default), groq or xai.
AI_PROVIDER=gemini
# AI_API_KEY=PASTE_KEY
# AI_MODEL=
