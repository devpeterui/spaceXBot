# Template only. Type the real values in Render > Environment, never commit them.
ACCESS_CODE=CHANGE-ME-to-a-long-random-code
BROKER=deriv
TIMEZONE=Africa/Nairobi
PYTHON_VERSION=3.12.7

# --- Deriv (demo and real accounts): token + app id from https://developers.deriv.com
# DERIV_TOKEN=PASTE_TOKEN
# DERIV_APP_ID=PASTE_APP_ID
# DERIV_ACCOUNT_ID=   (optional default; the page can switch accounts)

# --- Safety limits
ALLOW_LIVE=true
MAX_STAKE=1
MAX_BULK=5
MAX_DAILY_LOSS_PCT=3
DAILY_PROFIT_TARGET=0
DAILY_LOSS_LIMIT=0
TRADE_START_HOUR=0
TRADE_END_HOUR=24

# AI is NOT needed. Only set these if you want the old optional chat/AI signal routes.
# AI_PROVIDER=gemini
# AI_API_KEY=

# Minimum win payout as % of stake. Trades quoted below this are refused (0 = off)
MIN_PAYOUT_PCT=80
